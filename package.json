{
  "name": "projectv",
  "private": true,
  "scripts": {
    "build": "npm run build:js",
    "build:js": "npm run build:dashboard && npm run build:discover && npm run build:orders && npm run build:commerce",
    "build:dashboard": "esbuild static/scripts/app.js --bundle --minify --outfile=static/scripts/app.bundle.js",
    "build:discover": "esbuild static/scripts/discover.js --bundle --minify --outfile=static/scripts/discover.bundle.js",
    "build:orders": "esbuild static/scripts/orders.js --bundle --minify --outfile=static/scripts/orders.bundle.js",
    "watch:js": "esbuild static/scripts/app.js --bundle --sourcemap --outfile=static/scripts/app.bundle.js --watch",
    "build:commerce": "esbuild static/scripts/commerce.jsx --bundle --minify --define:process.env.NODE_ENV=\\\"production\\\" --outfile=static/scripts/commerce.bundle.js --external:crypto"
  },
  "dependencies": {
    "@crossmint/client-sdk-react-ui": "4.8.0",
    "@floating-ui/dom": "^1.8.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "esbuild": "^0.28.2"
  }
}
