SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY = your-publishable-or-anon-key
OPENAI_API_KEY = your-openai-api-key
OPENAI_MODEL = gpt-5.6-terra
ELEVENLABS_API_KEY = your-elevenlabs-api-key
# Created by `make voice-agent`; the agent requires signed sessions.
ELEVENLABS_AGENT_ID = your-elevenlabs-agent-id
OPENWEBNINJA_API_KEY = your-openweb-ninja-api-key
DATA_MODE = live

# Crossmint Agent Checkouts is production-only. Both keys must use the same project.
CROSSMINT_SERVER_API_KEY = sk_production_your-server-key
CROSSMINT_CLIENT_API_KEY = ck_production_your-client-key
# Server-only Supabase key for trusted order writes. Never expose in browser config.
SUPABASE_SECRET_KEY = your-server-secret-key
